  "narrative": {
    "northStar": "ShiftVPS website identity",
    "overview": "Operate mode. The native Android, Windows and macOS interface follows the user's explicit request to match the ShiftVPS website: near-black ground, locally bundled IBM Plex Sans, quiet dots, bordered dark surfaces and a blue vertical-gradient main action. These confirmed choices supersede the first prototype's generic typography and flat-button restriction.\n\nThe interface keeps the connection task compact and legible. Brand detail lives in the shared palette, type and component treatment. Cards remain quiet; the primary action carries the strongest color. The values below describe the existing Compose implementation rather than a new visual direction.",
    "keyCharacteristics": [
      "Website identity carried into native controls.",
      "Explicit connection states and a single prominent action.",
      "Country names remain readable beside decorative native flags.",
      "Honest example data and bounded verification claims."
    ],
    "rules": [
      {
        "name": "The Website Identity Rule",
        "body": "Preserve the confirmed website palette, bundled Plex typography, quiet dots and gradient action when extending this interface.",
        "section": "colors"
      },
      {
        "name": "The State Has Words Rule",
        "body": "Pair status color and selection tint with explicit text and native control semantics.",
        "section": "colors"
      },
      {
        "name": "The Flat Card Rule",
        "body": "Cards use tonal layering and borders; the enabled primary action alone receives the soft native elevation shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the recorded palette, Plex type roles and native Material interaction behavior.",
      "Do keep country names beside decorative vectors selected only by authoritative country metadata.",
      "Do retain the neutral globe for unknown or unsupported countries.",
      "Do keep errors and updates inline and connection actions reachable through scrolling.",
      "Do label illustrative data and state the limits of CPU-rendered previews."
    ],
    "donts": [
      "Don't restore the removed .ru routing caption; its removal does not change the centrally managed DIRECT policy.",
      "Don't infer a country from a server label or hostname, or depend on flag emoji support.",
      "Don't invent latency, availability, signal strength or performance graphics.",
      "Don't add protocol editors, unmanaged imports, animated halos or glass treatments to this simple client.",
      "Don't treat a raster fixture as proof of real-device connectivity, large-font behavior or OS accessibility."
    ]
  }
}
