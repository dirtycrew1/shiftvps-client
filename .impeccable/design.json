  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Native gradient action translated to a documentation specimen. Browser focus treatment is a panel affordance; native controls retain Material behavior.",
      "html": "<div class=\"ds-specimen\"><span class=\"ds-specimen-label\">Пример интерфейса</span><button class=\"ds-primary\" type=\"button\">Подключиться</button></div>",
      "css": ".ds-specimen{padding:20px;background:#08080B;color:#EDEDF0}.ds-specimen-label{display:block;margin-bottom:10px;color:#A5A7B2;font:12px/18px 'IBM Plex Sans',sans-serif}.ds-primary{font-family:'IBM Plex Sans',sans-serif;display:block;width:100%;min-height:56px;padding:14px 20px;border:0;border-radius:12px;background:linear-gradient(#5365D8,#4D5FD4);color:#FFFFFF;font-size:16px;font-weight:600;line-height:22px;text-align:center}.ds-primary:hover{cursor:pointer}.ds-primary:focus-visible{outline:2px solid #9DAAFF;outline-offset:3px}.ds-primary:active{outline-offset:1px}.ds-primary:disabled{background:#17181E;color:#A5A7B2;cursor:default}"
    },
    {
      "name": "Secondary stop action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Dark bordered disconnect action; it remains distinct from the blue start action.",
      "html": "<div class=\"ds-specimen\"><span class=\"ds-specimen-label\">Пример интерфейса</span><button class=\"ds-secondary\" type=\"button\">Отключиться</button></div>",
      "css": ".ds-specimen{padding:20px;background:#08080B;color:#EDEDF0}.ds-specimen-label{display:block;margin-bottom:10px;color:#A5A7B2;font:12px/18px 'IBM Plex Sans',sans-serif}.ds-secondary{font-family:'IBM Plex Sans',sans-serif;display:block;width:100%;min-height:56px;padding:14px 20px;border:1px solid #2B2C34;border-radius:12px;background:#17181E;color:#FFFFFF;font-size:16px;font-weight:600;line-height:22px;text-align:center}.ds-secondary:hover{cursor:pointer}.ds-secondary:focus-visible{outline:2px solid #9DAAFF;outline-offset:3px}.ds-secondary:active{outline-offset:1px}.ds-secondary:disabled{color:#A5A7B2;cursor:default}"
    },
    {
      "name": "Compact text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Refresh and connection-check actions use the compact label role and a native minimum target.",
      "html": "<div class=\"ds-specimen\"><span class=\"ds-specimen-label\">Пример интерфейса</span><button class=\"ds-text-action\" type=\"button\">Обновить</button></div>",
      "css": ".ds-specimen{padding:20px;background:#08080B;color:#EDEDF0}.ds-specimen-label{display:block;margin-bottom:10px;color:#A5A7B2;font:12px/18px 'IBM Plex Sans',sans-serif}.ds-text-action{font-family:'IBM Plex Sans',sans-serif;min-height:48px;padding:0 8px;border:0;background:transparent;color:#9DAAFF;font-size:13px;font-weight:500;line-height:18px}.ds-text-action:hover{cursor:pointer}.ds-text-action:focus-visible{outline:2px solid #9DAAFF;outline-offset:2px}.ds-text-action:active{outline-offset:0}.ds-text-action:disabled{color:#A5A7B2;cursor:default}"
    },
    {
      "name": "Connection card",
      "kind": "card",
      "refersTo": "connection-card",
      "description": "Synthetic disconnected specimen showing the quiet card, power geometry, explicit state and country text. The primary action is documented separately.",
      "html": "<div class=\"ds-specimen\"><span class=\"ds-specimen-label\">Пример интерфейса</span><section class=\"ds-connection\"><div class=\"ds-connection-row\"><div class=\"ds-power\"><svg aria-hidden=\"true\" viewBox=\"0 0 28 28\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"><path d=\"M20.745 6.509A10.08 10.08 0 1 1 7.255 6.509M14 1.68V12.88\"/></svg></div><div><strong class=\"ds-state\">Отключено</strong><div class=\"ds-country\"><svg aria-hidden=\"true\" viewBox=\"0 0 640 480\" width=\"28\" height=\"21\"><path fill=\"#005293\" d=\"M0 0h640v480H0z\"/><path fill=\"#fecb00\" d=\"M176 0v192H0v96h176v192h96V288h368v-96H272V0z\"/></svg><span>Швеция</span></div></div></div></section></div>",
      "css": ".ds-specimen{padding:20px;background:#08080B;color:#EDEDF0}.ds-specimen-label{display:block;margin-bottom:10px;color:#A5A7B2;font:12px/18px 'IBM Plex Sans',sans-serif}.ds-connection{font-family:'IBM Plex Sans',sans-serif;padding:20px;border:1px solid #2B2C34;border-radius:20px;background:#101115;color:#EDEDF0}.ds-connection-row{display:flex;align-items:center;gap:16px}.ds-power{display:grid;place-items:center;width:56px;height:56px;border-radius:16px;background:#17181E;color:#A5A7B2;flex-shrink:0}.ds-state{display:block;font-size:24px;font-weight:600;line-height:30px;letter-spacing:-.3px}.ds-country{display:flex;align-items:center;gap:7px;margin-top:5px;color:#A5A7B2;font-size:14px;line-height:21px}.ds-country svg{width:20px;height:15px;border-radius:3px}"
    },
    {
      "name": "Selected server row",
      "kind": "custom",
      "refersTo": "server-row-selected",
      "description": "Synthetic row using fixture values; native selection includes a radio role, written label and tint. The Sweden paths come from the pinned flag-icons source.",
      "html": "<div class=\"ds-specimen\"><span class=\"ds-specimen-label\">Пример интерфейса</span><label class=\"ds-server\"><input class=\"ds-radio\" type=\"radio\" name=\"ds-country-specimen\" checked><svg aria-hidden=\"true\" viewBox=\"0 0 640 480\" width=\"28\" height=\"21\"><path fill=\"#005293\" d=\"M0 0h640v480H0z\"/><path fill=\"#fecb00\" d=\"M176 0v192H0v96h176v192h96V288h368v-96H272V0z\"/></svg><span class=\"ds-server-name\">Швеция<small class=\"ds-server-selected\">Выбран</small></span><span class=\"ds-latency\">82 мс<small>задержка</small></span></label></div>",
      "css": ".ds-specimen{padding:20px;background:#08080B;color:#EDEDF0}.ds-specimen-label{display:block;margin-bottom:10px;color:#A5A7B2;font:12px/18px 'IBM Plex Sans',sans-serif}.ds-server{font-family:'IBM Plex Sans',sans-serif;display:flex;align-items:center;gap:10px;min-height:76px;padding:12px 14px;border-radius:16px;background:#1D2240;color:#EDEDF0}.ds-radio{width:20px;height:20px;margin:0 2px 0 0;accent-color:#9DAAFF;flex-shrink:0}.ds-server svg{border-radius:3px;flex-shrink:0}.ds-server-name{flex:1;font-size:17px;font-weight:600;line-height:24px}.ds-server-selected{display:block;margin-top:1px;color:#9DAAFF;font-size:12px;font-weight:400;line-height:18px}.ds-latency{text-align:right;font-size:13px;font-weight:500;line-height:18px}.ds-latency small{display:block;margin-top:2px;color:#A5A7B2;font-size:12px;font-weight:400;line-height:18px}.ds-server:hover{cursor:pointer}.ds-server:focus-within{outline:2px solid #9DAAFF;outline-offset:2px}.ds-radio:focus-visible{outline:2px solid #9DAAFF;outline-offset:2px}"
    },
